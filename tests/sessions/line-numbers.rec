//! Feeder firmware: the schedule.

const MEALS: [u8; 3] = [7, 12, 19];

fn main() {
    for hour in MEALS {
        // each meal is logged, so the vet can see when Ada ate and how much was left in the bowl
        log(hour);
    }
}

fn log(hour: u8) {
    println!("meal at {hour}:00");
}


#!/usr/bin/env zsh
# Refuse a commit that CI's rustfmt steps would fail: the crate, the fuzz targets and the bench driver.
# Enable once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
bad=()
for manifest in Cargo.toml fuzz/Cargo.toml bench/b2/Cargo.toml; do
  [[ -f $manifest ]] || continue
  cargo fmt --manifest-path $manifest --all -- --check > /dev/null 2>&1 || bad+=($manifest)
done
(( ${#bad} == 0 )) && exit 0
print -u2 "pre-commit: not rustfmt-clean: ${(j:, :)bad}"
for manifest in $bad; do
  print -u2 "  cargo fmt --manifest-path $manifest --all"
done
print -u2 "then stage the result; or commit with --no-verify to skip this check"
exit 1

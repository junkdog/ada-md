# Shared by every clip: build.zsh puts it ahead of each tape. JetBrains Mono, as on the page; the
# Nerd Font build is the same face, for machines that only have that one.
Set Shell zsh
Set FontSize 14
Set FontFamily "JetBrains Mono, JetBrainsMono Nerd Font Mono"
Set Padding 12
Set Theme "GruvboxDark"
Set TypingSpeed 80ms
Set Framerate 24
Set CursorBlink false
